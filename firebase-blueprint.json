{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated ESK Systems client profile stored privately by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 180
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["client"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "QuoteRequest": {
      "title": "QuoteRequest",
      "description": "Saved project scope estimate and consultation request owned by an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceCode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^ESK-[0-9]{4,8}$"
        },
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "organization": {
          "type": "string",
          "maxLength": 140
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 180
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "serviceIds": {
          "type": "array"
        },
        "slaTier": {
          "type": "string",
          "enum": ["basic", "business", "enterprise"]
        },
        "estimatedBaseline": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["submitted", "reviewed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "referenceCode",
        "clientName",
        "email",
        "serviceIds",
        "slaTier",
        "estimatedBaseline",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Support dispatch ticket logged by an authenticated ESK Systems user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceCode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^ESK-[0-9]{4,8}$"
        },
        "subject": {
          "type": "string",
          "minLength": 4,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "maxLength": 80
        },
        "priority": {
          "type": "string",
          "enum": ["standard", "priority", "critical"]
        },
        "status": {
          "type": "string",
          "enum": ["Open", "In Progress", "Resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "referenceCode",
        "subject",
        "category",
        "priority",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceNote": {
      "title": "WorkspaceNote",
      "description": "Saved audio transcription, search brief, or AI advisor note persisted in Firestore.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sourceType": {
          "type": "string",
          "enum": ["transcription", "search", "chat"]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "sourceType", "title", "content", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents isolated by authenticated UID."
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/QuoteRequest" },
      "description": "Client project quote requests scoped to ownerId."
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Client IT support tickets scoped to ownerId."
    },
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/WorkspaceNote" },
      "description": "Saved AI transcriptions, grounded search briefs, and chat notes scoped to ownerId."
    }
  }
}
